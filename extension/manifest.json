{
  "manifest_version": 3,
  "name": "Photo Shortlist",
  "version": "0.1.4",
  "author": "kutsin@gmail.com",
  "description": "Keep photos as you review an album full-size, then select your shortlist in Google Photos.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "commands": {
    "toggle-keep": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Keep or unkeep the current photo"
    }
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Photo Shortlist",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://photos.google.com/*"],
    "js": ["core.js", "photos-adapter.js", "diagnostics.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["dock.css"],
    "matches": ["https://photos.google.com/*"]
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
